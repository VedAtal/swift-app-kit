# Settings for swift-app-kit's setup.sh. It reads this with bash, so quote values.

# The app's name: the .app, the executable product in Package.swift, and the menus.
APP_NAME="Example"
# Keep this once people have it installed: macOS keys settings and permissions to it.
BUNDLE_ID="local.example"
# SF Symbol for the menu bar icon and the app icon (browse them in Apple's SF Symbols app).
SYMBOL="star"
# Optional: your own glyph instead of SYMBOL, as a PNG in this folder. Only its alpha is used, so
# one image works in light and dark menu bars. Crop it to the shape so it fills the menu bar slot.
# GLYPH="glyph.png"
# The app icon's background gradient, top to bottom, as "red green blue" from 0 to 1.
ICON_TOP="0.36 0.52 1.0"
ICON_BOTTOM="0.50 0.30 0.93"
# Printed after "✓ Example is running." when setup finishes.
INSTALL_NOTES="Look for the star in the menu bar."
